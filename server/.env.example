# 服务端口
PORT=3001

# Qwen（通义千问）API Key，OpenAI 兼容接口
# 申请地址：https://dashscope.console.aliyun.com/
QWEN_API_KEY=

# Qwen OpenAI 兼容模式 Base URL
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 上传文件保存目录（相对 server/ 目录）
UPLOAD_DIR=uploads

# 单文件大小上限（MB）
MAX_FILE_SIZE_MB=10

# PostgreSQL + pgvector 连接串
DATABASE_URL=postgres://kba:kba123456@localhost:5432/knowledge_base

# 嵌入模型
QWEN_EMBEDDING_MODEL=text-embedding-v3

# 对话模型与 RAG 检索条数
QWEN_CHAT_MODEL=qwen-plus
RAG_TOP_K=5

# JWT 登录鉴权密钥（用 openssl rand -hex 32 生成）
JWT_SECRET=
JWT_EXPIRES_IN=12h

# 日志：级别与文件（pino）
LOG_LEVEL=info
LOG_FILE=logs/app.log

# 超时（毫秒）：模型流式空闲超时 / 向量化请求超时
CHAT_TIMEOUT_MS=30000
EMBEDDING_TIMEOUT_MS=15000

# 联网搜索（Tavily，可选；留空则 web_search 工具不启用）
# 免费申请：https://tavily.com/
TAVILY_API_KEY=

# Agent 工具调用最大轮数（防止模型无限循环调工具）
AGENT_MAX_TOOL_ROUNDS=3
